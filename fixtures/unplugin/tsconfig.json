{
  "compilerOptions": {
    "allowJs": true,
    "lib": ["ESNext"],
    "module": "Preserve",
    "moduleResolution": "bundler",
    "noEmit": true,
    "paths": {
      "@fixture/*": ["./*"],
      "ts-refinement": ["../../packages/core/src/index.ts"]
    },
    "strict": true,
    "target": "ESNext"
  },
  "include": ["*.ts", "*.tsx", "commonjs/*.ts", "runtime.mjs"]
}
