{
  "compilerOptions": {
    "allowImportingTsExtensions": true,
    "lib": ["ESNext"],
    "module": "Preserve",
    "moduleResolution": "bundler",
    "noEmit": true,
    "paths": {
      "ts-refinement": ["../../packages/core/src/index.ts"]
    },
    "strict": true,
    "target": "ESNext",
    "types": ["vitest/globals"]
  },
  "include": ["*.ts", "../unplugin/*.ts"]
}
