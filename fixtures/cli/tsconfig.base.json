{
  "compilerOptions": {
    "lib": ["ESNext"],
    "module": "Preserve",
    "moduleResolution": "bundler",
    "plugins": [
      {
        "transform": "@ts-refinement/typescript-plugin/transformer",
        "transformProgram": true
      }
    ],
    "paths": {
      "ts-refinement": ["../../packages/core/src/index.ts"]
    },
    "strict": true,
    "target": "ESNext"
  }
}
