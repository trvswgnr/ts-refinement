{
  "name": "@ts-refinement/ttsc",
  "version": "0.2.0",
  "description": "TypeScript-Go diagnostics and transforms for ts-refinement",
  "keywords": [
    "refinement-types",
    "ttsc",
    "typescript-go",
    "validation"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/trvswgnr/ts-refinement.git",
    "directory": "packages/ttsc-plugin"
  },
  "files": [
    "dist",
    "native",
    "src"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.mjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs",
      "default": "./dist/index.mjs"
    },
    "./check": {
      "types": "./dist/check.d.mts",
      "import": "./dist/check.mjs",
      "default": "./dist/check.mjs"
    },
    "./transform": {
      "types": "./dist/transform.d.mts",
      "import": "./dist/transform.mjs",
      "default": "./dist/transform.mjs"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "bunx --no-install tsdown --config ../../tsdown.config.ts --filter ttsc-plugin",
    "prepack": "bun run build"
  },
  "peerDependencies": {
    "@ts-refinement/runtime": "0.2.0",
    "ts-refinement": "0.2.0",
    "ttsc": ">=0.28 <1",
    "typescript": ">=7"
  },
  "engines": {
    "node": ">=22.18.0"
  }
}
