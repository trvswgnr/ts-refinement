{
  "name": "ts-refinement",
  "version": "0.1.0",
  "description": "JavaScript-predicate refinement types for TypeScript",
  "keywords": [
    "refinement-types",
    "typescript",
    "validation"
  ],
  "license": "MIT",
  "files": [
    "dist",
    "src"
  ],
  "type": "module",
  "sideEffects": false,
  "types": "./dist/index.d.mts",
  "exports": {
    ".": {
      "types": "./dist/index.d.mts"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "bunx --no-install tsdown --config ../../tsdown.config.ts --filter core",
    "prepack": "bun run build && bun run --cwd ../cli build && ts-refinement verify dist"
  },
  "engines": {
    "node": ">=20.19.0"
  },
  "ts-refinement": {
    "verify": {
      "outDir": "dist"
    }
  }
}
