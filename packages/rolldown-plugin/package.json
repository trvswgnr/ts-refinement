{
  "name": "@ts-refinement/rolldown",
  "version": "0.1.0",
  "description": "Rolldown and tsdown transform for ts-refinement assertions",
  "keywords": [
    "refinement-types",
    "rolldown",
    "tsdown",
    "typescript",
    "validation"
  ],
  "license": "MIT",
  "files": [
    "dist",
    "src"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.mjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs",
      "default": "./dist/index.mjs"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "bunx --no-install tsdown --config ../../tsdown.config.ts --filter rolldown-plugin",
    "prepack": "bun run build"
  },
  "dependencies": {
    "magic-string": "^0.30.21"
  },
  "peerDependencies": {
    "@ts-refinement/runtime": "0.1.0",
    "rolldown": ">=1 <2",
    "ts-refinement": "0.1.0",
    "typescript": ">=5.7 <7"
  },
  "engines": {
    "node": ">=20.19.0"
  }
}
