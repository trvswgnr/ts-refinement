{
  "name": "@ts-refinement/typescript-plugin",
  "version": "0.1.0",
  "description": "TypeScript language-service diagnostics for ts-refinement",
  "keywords": [
    "language-service",
    "refinement-types",
    "typescript",
    "validation"
  ],
  "license": "MIT",
  "files": [
    "dist",
    "src"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "types": "./dist/index.d.cts",
  "exports": {
    ".": {
      "types": "./dist/index.d.cts",
      "require": "./dist/index.cjs",
      "default": "./dist/index.cjs"
    },
    "./transformer": {
      "types": "./dist/transformer.d.cts",
      "require": "./dist/transformer.cjs",
      "default": "./dist/transformer.cjs"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "bunx --no-install tsdown --config ../../tsdown.config.ts --filter typescript-plugin",
    "prepack": "bun run build"
  },
  "dependencies": {
    "@ts-refinement/analyzer": "0.1.0"
  },
  "peerDependencies": {
    "ts-refinement": "0.1.0",
    "typescript": ">=5.7 <7"
  },
  "engines": {
    "node": ">=20.19.0"
  }
}
