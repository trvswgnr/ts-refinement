{
  "name": "@ts-refinement/unplugin",
  "version": "0.1.0",
  "description": "Unified build integration for ts-refinement assertions",
  "keywords": [
    "esbuild",
    "farm",
    "refinement-types",
    "rolldown",
    "rollup",
    "rspack",
    "unplugin",
    "vite",
    "webpack"
  ],
  "license": "MIT",
  "files": [
    "dist",
    "src"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.mjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs",
      "default": "./dist/index.mjs"
    },
    "./esbuild": {
      "types": "./dist/esbuild.d.mts",
      "import": "./dist/esbuild.mjs",
      "default": "./dist/esbuild.mjs"
    },
    "./farm": {
      "types": "./dist/farm.d.mts",
      "import": "./dist/farm.mjs",
      "default": "./dist/farm.mjs"
    },
    "./rolldown": {
      "types": "./dist/rolldown.d.mts",
      "import": "./dist/rolldown.mjs",
      "default": "./dist/rolldown.mjs"
    },
    "./rollup": {
      "types": "./dist/rollup.d.mts",
      "import": "./dist/rollup.mjs",
      "default": "./dist/rollup.mjs"
    },
    "./rspack": {
      "types": "./dist/rspack.d.mts",
      "import": "./dist/rspack.mjs",
      "default": "./dist/rspack.mjs"
    },
    "./vite": {
      "types": "./dist/vite.d.mts",
      "import": "./dist/vite.mjs",
      "default": "./dist/vite.mjs"
    },
    "./vitest": {
      "types": "./dist/vitest.d.mts",
      "import": "./dist/vitest.mjs",
      "default": "./dist/vitest.mjs"
    },
    "./loader": {
      "types": "./dist/loader.d.mts",
      "import": "./dist/loader.mjs",
      "default": "./dist/loader.mjs"
    },
    "./webpack": {
      "types": "./dist/webpack.d.mts",
      "import": "./dist/webpack.mjs",
      "default": "./dist/webpack.mjs"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "bunx --no-install tsdown --config ../../tsdown.config.ts --filter unplugin",
    "prepack": "bun run build"
  },
  "dependencies": {
    "@ts-refinement/analyzer": "0.1.0",
    "magic-string": "^0.30.21",
    "unplugin": "^3.3.0"
  },
  "peerDependencies": {
    "@farmfe/core": ">=1 <2",
    "@rspack/core": ">=1 <3",
    "@ts-refinement/runtime": "0.1.0",
    "esbuild": ">=0.25 <1",
    "rolldown": ">=1 <2",
    "rollup": ">=4 <5",
    "ts-refinement": "0.1.0",
    "typescript": ">=5.7 <7",
    "vite": ">=6 <9",
    "webpack": ">=5 <6"
  },
  "peerDependenciesMeta": {
    "@farmfe/core": {
      "optional": true
    },
    "@rspack/core": {
      "optional": true
    },
    "esbuild": {
      "optional": true
    },
    "rolldown": {
      "optional": true
    },
    "rollup": {
      "optional": true
    },
    "vite": {
      "optional": true
    },
    "webpack": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=20.19.0"
  }
}
