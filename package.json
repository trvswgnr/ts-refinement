{
  "name": "ts-refinement-workspace",
  "version": "0.1.0",
  "private": true,
  "description": "JavaScript-predicate refinement types for TypeScript",
  "license": "MIT",
  "workspaces": [
    "examples/*",
    "packages/*"
  ],
  "type": "module",
  "scripts": {
    "build": "tsdown",
    "fmt": "oxfmt --check .",
    "fmt:fix": "oxfmt .",
    "gate": "bun run typecheck && bun run lint && bun run fmt && bun run test:coverage && bun run test:package && bun run test:example",
    "lint": "oxlint .",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:example": "cd examples/tsdown && bunx tsdown",
    "test:package": "bun run --workspaces --sequential --if-present build && node scripts/verify-packages.mjs",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.2",
    "@jridgewell/trace-mapping": "^0.3.31",
    "@oxlint/plugins": "^1.80.0",
    "@types/bun": "^1.4.0",
    "@vitest/coverage-v8": "^4.1.11",
    "fast-check": "^4.9.0",
    "oxfmt": "^0.65.0",
    "oxlint": "^1.80.0",
    "oxlint-tsgolint": "^7.0.2001",
    "publint": "^0.3.24",
    "rolldown": "^1.2.6",
    "tsdown": "^0.22.14",
    "typescript": "^6.0.0",
    "typescript-5-7": "npm:typescript@5.7.3",
    "typescript-5-9": "npm:typescript@5.9.3",
    "vitest": "^4.1.11"
  },
  "engines": {
    "node": ">=22.18.0"
  },
  "packageManager": "bun@1.4.0"
}
